MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ace_finance?retryWrites=true&w=majority
JWT_SECRET=your-long-random-secret-here
PORT=3001
FRONTEND_URL=http://localhost:3000

# Gmail SMTP (recommended for local/dev)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password into SMTP_PASS (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your.gmail@gmail.com

# Azure Communication Services Email (production — HTTPS, no SMTP ports needed)
# Portal → Communication Service (ace-finance-communication) → Keys → Connection string
# Also requires an Email Communication Service with a linked domain (azurecomm.net or custom).
# Portal → Email Communication Service → Domains → copy sender, e.g. DoNotReply@xxxx.azurecomm.net
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://ace-finance-communication.unitedstates.communication.azure.com/;accesskey=...
AZURE_EMAIL_SENDER=DoNotReply@aceolution.com
# Optional: copy of every outbound email + where replies go (Outlook mailbox OK)
AZURE_EMAIL_BCC=finance@aceolution.com
AZURE_EMAIL_REPLY_TO=finance@aceolution.com

# Azure Blob Storage (invoices + payment receipts)
# Portal → Storage account → Access keys → Connection string
# Containers → create private container: ace-finance-files
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=acefinance;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=ace-finance-files
