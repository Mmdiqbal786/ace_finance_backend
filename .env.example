# Live MongoDB (company data)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ace_finance?retryWrites=true&w=majority
# Demo MongoDB (same cluster, separate database)
MONGODB_URI_DEMO=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ace_finance_demo?retryWrites=true&w=majority
JWT_SECRET=your-long-random-secret-here
PORT=3001
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins (comma-separated), e.g. preview SWA URLs
# CORS_ORIGINS=https://nice-xxx.azurestaticapps.net

# Demo Access gate — shared with the demo-guide unlock (verified via POST /auth/verify-demo-access).
# Required in production (NODE_ENV=production); optional locally when unset.
DEMO_ACCESS_CODE=your-shared-demo-guide-password
# ENABLE_API_DOCS=false  # Azure/prod: keep false. Set true only for temporary debug.
# On Azure App Service, docs stay OFF unless ENABLE_API_DOCS=true (even if NODE_ENV unset).

# Bootstrap seed — POST /auth/seed requires header X-Seed-Secret with this value.
# Leave unset to disable seed entirely (recommended after first bootstrap).
# SEED_SECRET=long-random-seed-secret
# Production: boot does not auto-create known-password users unless:
# ALLOW_BOOT_SEED=true

# Gmail SMTP (recommended for local/dev)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password into SMTP_PASS (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your.gmail@gmail.com

# Azure Communication Services Email (production — HTTPS, no SMTP ports needed)
# Portal → Communication Service (ace-finance-communication) → Keys → Connection string
# Also requires an Email Communication Service with a linked domain (azurecomm.net or custom).
# Portal → Email Communication Service → Domains → copy sender, e.g. DoNotReply@xxxx.azurecomm.net
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://ace-finance-communication.unitedstates.communication.azure.com/;accesskey=...
AZURE_EMAIL_SENDER=DoNotReply@aceolution.com
# Optional: copy of every outbound email + where replies go (Outlook mailbox OK)
AZURE_EMAIL_BCC=finance@aceolution.com
AZURE_EMAIL_REPLY_TO=finance@aceolution.com

# Azure Blob Storage (invoices + payment receipts)
# Portal → Storage account → Access keys → Connection string
# Containers → create private containers: ace-finance-files (live) + ace-finance-files-demo (demo)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=acefinance;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=ace-finance-files
AZURE_STORAGE_CONTAINER_DEMO=ace-finance-files-demo
# Training walkthrough MP4s (frontend npm run docs:upload-videos) use a separate
# private container ace-finance-docs-videos + read SAS — do not put invoices here.

# Microsoft Entra ID (Azure AD) — Sign in with Microsoft
# App registration → Authentication → Web redirect URI must match AZURE_REDIRECT_URI
# Local example: http://localhost:3001/auth/microsoft/callback
# Live example: https://ace-finance-api-....azurewebsites.net/auth/microsoft/callback
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
AZURE_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
# Aceolution company emails for new Microsoft users
# *aceolution* = every Aceolution domain (.com, .tw, and any other @aceolution.*)
# Or list exact domains: aceolution.com,aceolution.tw
ALLOWED_EMAIL_DOMAIN=*aceolution*
# Optional public API origin used when AZURE_REDIRECT_URI is omitted
# API_PUBLIC_URL=https://ace-finance-api-....azurewebsites.net
